@using Sandbox
@using Sandbox.UI
@namespace NavalCombat
@inherits PanelComponent
<root>
	@if ( Player is { } fighter )
	{
		<SwordDuelPanel Fighter=@fighter />
		@if ( !fighter.InDuel && fighter.Health > 0 )
		{
			<div class="card">
				<div class="title">SWORD ARENA</div>
				<div class="health">@fighter.Health HP</div>
				@if ( fighter.EquippedItem == HeldItem.Sword )
				{
					<div>@($"Face a fighter and press {Input.GetButtonOrigin( "Attack1" )} to lunge.")</div>
				}
				else
				{
					<div>@($"Equip your sword ({Input.GetButtonOrigin( "Slot1" )}) to lunge.")</div>
				}
				<div class="hint">WASD move · Mouse look · C camera</div>
				<div class="hint">Spar with the red NPC or join a player for a rhythm duel.</div>
				@if ( fighter.Feedback != "Ready" && (fighter.DuelEndedAt < 0 || Time.Now - fighter.DuelEndedAt >= 3) )
				{
					<div>@fighter.Feedback</div>
				}
			</div>
			<div class="crosshair">+</div>
			@if ( fighter.CanHoldItem )
			{
				<div class="loadout"><EquipmentBar Item=@fighter.EquippedItem /></div>
			}
		}
	}
</root>
@code {
	private SwordFighter player;
	private SwordFighter Player
	{
		get
		{
			if ( !player.IsValid() || !player.IsLocalPlayer )
				player = Scene.GetAllComponents<SwordFighter>().FirstOrDefault( x => x.IsLocalPlayer );
			return player;
		}
	}
	protected override int BuildHash()
	{
		var fighter = Player;
		return System.HashCode.Combine( fighter, fighter?.Health, fighter?.Feedback, fighter?.InDuel,
			fighter?.EquippedItem, fighter?.CanHoldItem, Input.UsingController, fighter.IsValid() && Time.Now - fighter.DuelEndedAt < 3 );
	}
}
