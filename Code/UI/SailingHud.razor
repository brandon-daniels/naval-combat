@using Sandbox
@using Sandbox.UI
@namespace NavalCombat
@inherits PanelComponent
<root>
	<div class="mode">@(AtCannon ? "AT THE CANNON" : AtHelm ? "AT THE HELM" : AtMast ? "WORKING THE SAILS" : "ON DECK")</div>
	<div class="hint">@(AtCannon ? "W / S - Elevation | A / D - Aim | LEFT CLICK - Fire | E - Release" : AtHelm ? "A / D - Steer | E - Release helm" : AtMast ? "A / D - Rotate sail | W - Raise | S - Lower | E - Release mast" : "WASD - Walk | MOUSE - Look | SPACE - Jump | SHIFT - Run | C - View")</div>
	@if ( Player.CarriedBarrel.IsValid() ) { <div class="prompt">E - Drop barrel @(Player.WorldPosition.Distance( Player.Ship.WorldPosition ) <= 450 ? "and secure it aboard" : "")</div> }
	else if ( Player.AvailableBarrel.IsValid() ) { <div class="prompt">E - Carry goods barrel</div> }
	else if ( Ready ) { <div class="prompt">E - @(Player.AvailableStation is ShipCannon ? "Use cannon" : Player.AvailableStation is SailRig ? "Work the sails" : "Take the helm")</div> }
	else if ( !AtHelm && !AtMast && !AtCannon ) { <div class="objective">Lower and align the sail at the mast, then steer at the bow wheel.</div> }
	@if ( AtCannon ) { <div class="prompt">@CannonStatus</div> }
	@if ( Rig.IsValid() && Rig.Wind.IsValid() ) {
		<div class="wind">
			<div class="wind-title">WIND BLOWS TOWARD</div>
			<div class="compass"><div class="arrow" style="@ArrowStyle">↑</div></div>
			<div class="wind-detail">Relative to bow - top is ahead</div>
			<div class="sail-detail">@($"SAIL LOWERED {Deployment}% - CATCH {Catch}%")</div>
			<div class="wind-detail">@($"Trim {Trim}° - Sail power {Power}%")</div>
		</div>
	}
	<div class="recovery">R - Return to deck</div>
	@if ( Voyage.IsValid() )
	{
		<div class="voyage">
			<div class="voyage-title">THE FIRST VOYAGE</div>
			<div>@($"Coins {Voyage.Wallet.Balance}  |  Cargo {Voyage.Cargo.UsedCapacity}/{Voyage.Cargo.Capacity}")</div>
			<div>@($"Speed {Player.Ship.Body.Velocity.WithZ( 0 ).Length:0}  |  Hull {Hull.Health}/{Hull.MaximumHealth}")</div>
			<div class="feedback">@(Voyage.NearestPort is { } nearby && nearby.CanTrade( Player ) ? $"Trading available: {nearby.PortName}" : "Sail to a buoy and slow down to trade")</div>
			<div>@ProductionStatus</div>
			@foreach ( var port in Player.Scene.GetAllComponents<VoyagePort>() )
			{
				<div class="route">@PortText( port )</div>
			}
			<div class="actions">1 - Invest 100 at Beacon</div>
			<div>E - Carry/drop the produced barrel aboard</div>
			<div>2 - Deliver secured barrels at the nearest sell point</div>
			<div>@UpgradeText( ShipUpgradeStat.CargoCapacity, 3 )</div>
			<div>@UpgradeText( ShipUpgradeStat.HullHealth, 4 )</div>
			<div>@UpgradeText( ShipUpgradeStat.SailingPerformance, 5 )</div>
			<div class="feedback">@Voyage.Feedback</div>
			<div class="route">Trade near a buoy with sail raised and speed below 100.</div>
		</div>
	}
</root>
@code {
	[Property] public ShipPlayer Player { get; set; }
	private PlayerVoyage Voyage => Player.IsValid() ? Player.GetComponent<PlayerVoyage>() : null;
	private ShipHealth Hull => Player.Ship.GetComponent<ShipHealth>();
	private string ProductionStatus => Voyage.Production.IsProducing ? $"Production: {Voyage.Production.RemainingSeconds:0}s remaining" : Player.Scene.GetAllComponents<GoodsBarrel>().Any( x => x.OwnerId == Voyage.Identity && !x.SecuredShip.IsValid() ) ? "Goods ready at Beacon: carry the barrel aboard" : "Invest at Beacon, then deliver to Palm Island";
	private string PortText( VoyagePort port )
	{
		var delta = port.WorldPosition - Player.Ship.WorldPosition;
		var relative = Player.Ship.WorldRotation.Inverse * delta;
		var bearing = System.MathF.Atan2( relative.y, relative.x ) * 180 / System.MathF.PI;
		return $"{port.PortName}: {delta.Length:0} units, {System.MathF.Abs( bearing ):0}° {(bearing >= 0 ? "left" : "right")} | sells {port.SalePrice}/unit";
	}
	private string UpgradeText( ShipUpgradeStat stat, int key )
	{
		var upgrade = Voyage.Upgrades.AvailableUpgrades.FirstOrDefault( x => x is not null && x.Stat == stat );
		if ( upgrade is null ) return "Upgrade unavailable";
		var level = Voyage.Upgrades.GetLevel( upgrade );
		return $"{key} - {upgrade.DisplayName} {level}/{upgrade.MaximumLevel} | {(level >= upgrade.MaximumLevel ? "MAX" : upgrade.GetCost( level ).ToString())}";
	}
	private SailRig Rig => Player.IsValid() ? Player.Sails : null;
	private bool AtCannon => Player.IsValid() && Player.ActiveCannon.IsValid();
	private string CannonStatus => AtCannon ? $"{(Player.ActiveCannon.ReloadRemaining > 0 ? "RELOADING" : "READY")} | Elevation {Player.ActiveCannon.Elevation:0} | Aim {Player.ActiveCannon.Yaw:0}" : "";
	private bool AtHelm => Player.IsValid() && Player.IsAtHelm;
	private bool AtMast => Player.IsValid() && Player.IsAtMast;
	private bool Ready => Player.IsValid() && Player.AvailableStation.IsValid();
	private int Deployment => Rig.IsValid() ? (int)(Rig.Deployment * 100) : 0;
	private int Catch => Rig.IsValid() ? (int)(Rig.Alignment * 100) : 0;
	private int Power => Rig.IsValid() ? (int)(Rig.DriveFraction * 100) : 0;
	private int Trim => Rig.IsValid() ? (int)Rig.SailAngle : 0;
	private int WindAngle => Rig.IsValid() && Rig.Wind.IsValid() ? (int)(Rig.Wind.Heading - Rig.Ship.WorldRotation.Angles().yaw) : 0;
	private string ArrowStyle => $"transform: rotate({-WindAngle}deg);";
	protected override int BuildHash() => System.HashCode.Combine( System.HashCode.Combine( AtHelm, AtMast, AtCannon, CannonStatus ), Ready, Deployment, Catch, Power, Trim, WindAngle, (int)(Time.Now * 5) );
}
